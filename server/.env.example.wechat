# 微信支付配置

# 商户号
WECHAT_PAY_MCHID=1290305501

# 小程序AppID（需要在微信开放平台获取）
WECHAT_PAY_APPID=your_appid_here

# 证书序列号（需要在微信商户平台下载证书后获取）
WECHAT_PAY_SERIAL_NO=your_serial_no_here

# 商户私钥文件路径（需要在微信商户平台下载证书文件）
WECHAT_PAY_PRIVATE_KEY_PATH=/path/to/apiclient_key.pem

# APIv3密钥（需要在微信商户平台设置）
WECHAT_PAY_APIV3_KEY=luyu1985luyu1985luyu1985luyu1985

# 支付结果通知地址（需要配置为公网可访问的地址）
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/payment/wechat/notify

# 退款结果通知地址（可选）
WECHAT_PAY_REFUND_NOTIFY_URL=https://your-domain.com/api/payment/wechat/refund-notify
